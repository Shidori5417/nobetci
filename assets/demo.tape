Output assets/demo.gif

Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 15
Set Width 1200
Set Height 700
Set Theme "Catppuccin Mocha"
Set Framerate 12
Set Padding 12

# Isınma: sparkline'lar geçmişle dolsun diye kayıtta gizli.
Hide
Type "nobetci --demo"
Enter
Sleep 14s
Show

Sleep 2s
Type "j"
Sleep 800ms
Type "j"
Sleep 800ms
Type "k"
Sleep 800ms
Enter
Sleep 3s
Type "l"
Sleep 3s
Type "/"
Sleep 400ms
Type "hata"
Sleep 800ms
Enter
Sleep 2s
Escape
Sleep 500ms
Escape
Sleep 500ms
Escape
Sleep 1s
Type "a"
Sleep 3s
Type "a"
Sleep 500ms
Type "?"
Sleep 2500ms
Type "?"
Sleep 500ms
Type "q"
Sleep 500ms
